-- BUTTON HELPERS
local function createBtn(text, color, callback)
    local B = Instance.new("TextButton", Scroll)
    B.Size = UDim2.new(0.9, 0, 0, 30)
    B.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    B.Text = text .. ": OFF"
    B.TextColor3 = Color3.fromRGB(255, 255, 255)
    B.Font = Enum.Font.GothamBold
    B.TextSize = 10
    Instance.new("UICorner", B)
    local BS = Instance.new("UIStroke", B)
    BS.Thickness = 1
    
    local state = false
    B.MouseButton1Click:Connect(function()
        state = not state
        B.Text = text .. ": " .. (state and "ON" or "OFF")
        B.TextColor3 = state and color or Color3.fromRGB(255, 255, 255)
        BS.Color = state and color or Color3.fromRGB(40, 40, 40)
        callback(state)
    end)
end

-- // ESP HIGHLIGHTER
local function applyESP(obj, color)
    if not obj:FindFirstChild("ST4R_ESP") then
        local h = Instance.new("Highlight", obj)
        h.Name = "ST4R_ESP"
        h.FillColor = color
        h.FillTransparency = 0.5
        h.OutlineColor = Color3.new(1,1,1)
        
        local b = Instance.new("BillboardGui", obj)
        b.Name = "ST4R_Label"
        b.AlwaysOnTop = true
        b.Size = UDim2.new(0, 80, 0, 40)
        b.StudsOffset = Vector3.new(0, 3, 0)
        
        local t = Instance.new("TextLabel", b)
        t.Size = UDim2.new(1, 0, 1, 0)
        t.BackgroundTransparency = 1
        t.TextColor3 = color
        t.Font = Enum.Font.GothamBold
        t.TextSize = 10
    end
end

