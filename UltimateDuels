-- // 2. UNIVERSAL ESP HIGHLIGHTER FUNCTION
local function applyOmniESP(obj, color, labelText)
    if not obj:FindFirstChild("ST4R_ESP") then
        local h = Instance.new("Highlight", obj)
        h.Name = "ST4R_ESP"
        h.FillColor = color
        h.FillTransparency = 0.5
        h.OutlineColor = Color3.new(1, 1, 1)
        
        local b = Instance.new("BillboardGui", obj)
        b.Name = "ST4R_Label"
        b.AlwaysOnTop = true
        b.Size = UDim2.new(0, 100, 0, 50)
        b.StudsOffset = Vector3.new(0, 3, 0)
        
        local t = Instance.new("TextLabel", b)
        t.Size = UDim2.new(1, 0, 1, 0)
        t.BackgroundTransparency = 1
        t.TextColor3 = color
        t.Font = Enum.Font.GothamBold
        t.TextSize = 11
        t.Text = labelText
    end
end

-- // 3. AUTO FPS OPTIMIZER & BASE X-RAY
local function Optimize()
    settings().Rendering.QualityLevel = 1
    Lighting.GlobalShadows = false
    for _, v in pairs(game:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Material = Enum.Material.SmoothPlastic
            -- Auto X-Ray for Bases
            if v.Name:find(ST4R_Config.BaseName) then v.Transparency = 0.7 end
        elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("ParticleEmitter") then
            if v:IsA("ParticleEmitter") then v.Enabled = false else v.Transparency = 1 end
        end
    end
end
task.spawn(Optimize)

