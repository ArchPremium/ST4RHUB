-- // CORE HEARTBEAT LOOP
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")

    if ST4R_Config.Rainbow then
        Stroke.Color = Color3.fromHSV(tick() % 3 / 3, 0.8, 1)
        Title.TextColor3 = Color3.fromHSV(tick() % 3 / 3, 0.8, 1)
    end

    if hum then 
        hum.WalkSpeed = ST4R_Config.Speed 
        if ST4R_Config.NoAnim then for _, a in pairs(hum:GetPlayingAnimationTracks()) do a:Stop() end end
    end

    if root then
        -- AUTO-BAT LOGIC
        if ST4R_Config.AutoBat then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild(ST4R_Config.ItemName) then
                    root.CFrame = p.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                    local w = char:FindFirstChild(ST4R_Config.WeaponName) or LocalPlayer.Backpack:FindFirstChild(ST4R_Config.WeaponName)
                    if w then w.Parent = char w:Activate() end
                end
            end
        end

        -- AUTO-SECURE/WALK LOGIC
        if ST4R_Config.AutoSecure then
            local isHolding = char:FindFirstChild(ST4R_Config.ItemName)
            if not isHolding then
                for _, v in pairs(workspace:GetDescendants()) do
                    if v.Name == ST4R_Config.ItemName and v:IsA("BasePart") then
                        hum:MoveTo(v.Position)
                        if (v.Position - root.Position).Magnitude < 10 then firetouchinterest(root, v, 0) end
                        break
                    end
                end
            else
                local base = workspace:FindFirstChild(ST4R_Config.BaseName) or workspace:FindFirstChild(LocalPlayer.Name .. "Base")
                if base then hum:MoveTo(base.Position) end
            end
        end

        -- AUTO-GRAB LOGIC
        if ST4R_Config.AutoGrab and not ST4R_Config.AutoSecure then
            for _, v in pairs(workspace:GetDescendants()) do
                if v.Name == ST4R_Config.ItemName and v:IsA("BasePart") then
                    root.CFrame = v.CFrame * CFrame.new(0, 2, 0)
                    firetouchinterest(root, v, 0)
                    break
                end
            end
        end
    end
end)

