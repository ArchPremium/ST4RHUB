-- // 1. CLIENT-SIDE ANTI-KICK & ANTI-AFK
-- This intercepts common local anti-cheat kick commands
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if self == LocalPlayer and (method:lower() == "kick" or method:lower() == "destroy") then
        print("ST4R: Blocked a client-side kick attempt!")
        return task.wait(9e9) 
    end
    return oldNamecall(self, ...)
end)

