-- // MAIN LOOP
RunService.Heartbeat:Connect(function()
    local color = Color3.fromHSV(tick() % 3 / 3, 0.8, 1)
    MStroke.Color = color
    TStroke.Color = color
    Title.TextColor3 = color
    
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    
    if hum then 
        hum.WalkSpeed = ST4R_Config.Speed 
        if ST4R_Config.NoAnim then for _, a in pairs(hum:GetPlayingAnimationTracks()) do a:Stop() end end
    end

    if root then
        -- SILENT PASSIVE VACUUM (ALWAYS ON)
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == ST4R_Config.ItemName and v:IsA("BasePart") then
                local dist = (v.Position - root.Position).Magnitude
                if dist <= ST4R_Config.GrabRadius then
                    firetouchinterest(root, v, 0)
                    task.wait()
                    firetouchinterest(root, v, 1)
                end
                
                -- Item ESP
                if ST4R_Config.ESP_Enabled then
                    applyESP(v, Color3.new(0, 1, 0.5))
                    v.ST4R_Label.TextLabel.Text = "BRAIN [" .. math.floor(dist) .. "m]"
                    v.ST4R_ESP.Enabled = true v.ST4R_Label.Enabled = true
                else
                    if v:FindFirstChild("ST4R_ESP") then v.ST4R_ESP.Enabled = false v.ST4R_Label.Enabled = false end
                end
            end
        end

        -- PLAYER ESP
        if ST4R_Config.ESP_Enabled then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    applyESP(p.Character, Color3.new(1, 0.2, 0.2))
                    local d = math.floor((root.Position - p.Character.HumanoidRootPart.Position).Magnitude)
                    p.Character.ST4R_Label.TextLabel.Text = p.Name .. " [" .. d .. "m]"
                    p.Character.ST4R_ESP.Enabled = true p.Character.ST4R_Label.Enabled = true
                end
            end
        else
            for _, p in pairs(Players:GetPlayers()) do
                if p.Character and p.Character:FindFirstChild("ST4R_ESP") then p.Character.ST4R_ESP.Enabled = false p.Character.ST4R_Label.Enabled = false end
            end
        end

        -- AUTO-BAT
        if ST4R_Config.AutoBat then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild(ST4R_Config.ItemName) then
                    root.CFrame = p.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                    local w = char:FindFirstChild(ST4R_Config.WeaponName) or LocalPlayer.Backpack:FindFirstChild(ST4R_Config.WeaponName)
                    if w then w.Parent = char w:Activate() end
                end
            end
        end
    end
end)

